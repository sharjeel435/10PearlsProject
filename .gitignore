# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.production
API.txt

# ── Generated scratch outputs ─────────────────────────────────────────────────
scripts/pakistan_svg_path.txt

# ── Python bytecode and caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Large model binaries — always excluded regardless of location ─────────────
# The 498 MB model is stored in Hopsworks and downloaded at pipeline runtime.
*.joblib
*.joblib.sha256
*.pkl
*.pickle
*.h5
*.keras
.model-cache/
model-cache/

# ── Raw and processed training data ──────────────────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── EDA outputs (generated by notebooks, not needed in repo) ──────────────────
artifacts/eda/

# ── Old Streamlit dashboard (superseded by dashboard-next/) ──────────────────
/dashboard/


# ── Hopsworks pipeline logs ───────────────────────────────────────────────────
artifacts/hopsworks_logs/
artifacts/runtime/

# NOTE: artifacts/*.json, artifacts/*.csv, artifacts/*.md, artifacts/shap/ are
# intentionally NOT listed here — they are small and must be tracked so that
# GitHub Actions can commit them and Vercel can read them at build time.

# ── Frontend build outputs ────────────────────────────────────────────────────
node_modules/
.next/
dashboard-next/coverage/
dashboard-next/tsconfig.tsbuildinfo

# ── Frontend environment files ────────────────────────────────────────────────
dashboard-next/.env.local
dashboard-next/.env.production.local

# ── Auto-generated Next.js agent/AI files (re-created by next dev, not project docs) ──
dashboard-next/AGENTS.md
dashboard-next/CLAUDE.md
