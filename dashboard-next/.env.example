# ── Serving architecture ────────────────────────────────────────────────────
# This platform uses static-first ML serving — no live API server is needed.
# GitHub Actions runs daily:
#   scripts/predict.py + scripts/refresh_observations.py
#   → artifacts/*.json → dashboard-next/data/ → git commit → Vercel redeploy
#
# NEXT_PUBLIC_API_BASE_URL is NOT used and NOT required.

# ── Open-Meteo ──────────────────────────────────────────────────────────────
# Public API — no key required.

# ── Hopsworks (feature store — only needed for retraining) ──────────────────
HOPSWORKS_API_KEY=your_key_here
HOPSWORKS_PROJECT=DataProject
