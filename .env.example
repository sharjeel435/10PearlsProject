# Copy this file to .env and fill in the values.
# NEVER commit .env — it is listed in .gitignore.

# Hopsworks API key — obtain from Hopsworks project settings → API keys
HOPSWORKS_API_KEY=

# Hopsworks project name — must match the project that owns the Feature Group and Model Registry
HOPSWORKS_PROJECT=DataProject

# FastAPI — allowed CORS origins as a comma-separated list (production, staging, or localhost)
# Example: https://pearls.example.com,http://localhost:3000
MODEL_NAME=aqi_random_forest
MODEL_VERSION=1
MODEL_SHA256=
MODEL_CACHE_DIR=.model-cache
ALLOWED_ORIGINS=http://localhost:3000
# ALLOWED_ORIGIN_REGEX=https://pearls-aqi-[a-z0-9-]+-your-team\.vercel\.app
LOG_LEVEL=INFO
LOAD_MODEL_ON_STARTUP=1
